APP_NAME=Yetkaz
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=uz
APP_FALLBACK_LOCALE=uz
APP_FAKER_LOCALE=uz_UZ

# Vaqtlar bazada UTC saqlanadi, ko'rsatishda Asia/Tashkent ga o'giriladi.
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Kunlik log fayllari ishlatilsa (LOG_STACK=daily) — necha kun saqlansin.
LOG_DAILY_DAYS=14

# ==========================================================================
# PRODUCTION'GA O'TISHDA (bu qiymatlarni almashtiring)
# ==========================================================================
#   APP_ENV=production            APP_DEBUG=false           APP_URL=https://<domen>
#   LOG_LEVEL=warning             LOG_STACK=stderr,daily
#   SESSION_ENCRYPT=true          SESSION_SECURE_COOKIE=true   SESSION_DOMAIN=<domen>
#   OCTANE_HTTPS=true            NGINX_CONF=prod-ssl.conf
#   REVERB_SCHEME=https          REVERB_SCALING_ENABLED=true
#   REVERB_APP_KEY / REVERB_APP_SECRET — tasodifiy kuchli qiymatlar
#   VITE_REVERB_* (build ARG) — pastdagi "Production" izohiga qarang:
#     HOST=<domen>  PORT=443  SCHEME=https  PATH=/reverb  APP_KEY=<REVERB_APP_KEY>
#   TELEGRAM_WEBHOOK_SECRET=<tasodifiy 32+>   TELEGRAM_MINI_APP_URL=https://<domen>/app
#   DB_PASSWORD / PRINT_AGENT_TOKEN — kuchli, generatsiya qilingan
#   FILESYSTEM_PUBLIC_URL=https://<domen>/storage
# SSL: docker/prod/init-cert.sh -> NGINX_CONF=prod-ssl.conf -> up -d nginx (docs/deploy.md §7)
# ==========================================================================
# nginx konfiguratsiyasi: prod.conf (HTTP, SSL yo'q) yoki prod-ssl.conf (HTTPS)
NGINX_CONF=prod.conf

# --- Baza: PostgreSQL 16 + PostGIS ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=yetkaz
DB_USERNAME=yetkaz
DB_PASSWORD=secret
# TLS: lokalda 'prefer', boshqa hostdagi/managed Postgres uchun 'require' yoki 'verify-full'.
DB_SSLMODE=prefer

# Host'ga ochiladigan portlar (boshqa loyihalar bilan to'qnashmasligi uchun nostandart)
APP_FORWARD_PORT=8010
REVERB_FORWARD_PORT=8080
DB_FORWARD_PORT=55432
REDIS_FORWARD_PORT=56379
VITE_FORWARD_PORT=5174

# Docker konteyner foydalanuvchi UID/GID — `id -u` / `id -g` bilan mos qiling.
UID=1000
GID=1000

# --- Navbat / kesh / sessiya: Redis ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie xavfsizligi. Production (HTTPS) da SESSION_SECURE_COOKIE=true.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=yetkaz

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Horizon shu ulanishdan foydalanadi
REDIS_QUEUE_CONNECTION=default
HORIZON_PREFIX=yetkaz_horizon:

# --- WebSocket: Laravel Reverb ---
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=yetkaz
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Bir nechta Reverb jarayoni (prod) — Redis pub/sub orqali sinxron ulanish.
REVERB_SCALING_ENABLED=false

# Frontend (Vite) — BUILD VAQTIDA o'qiladi, runtime emas.
# Prod'da docker-compose.prod.yml bularni build ARG qilib uzatadi; o'zgargach
# `docker compose -f docker-compose.prod.yml build` (kerak bo'lsa --no-cache).
#   Lokal (vite dev server, to'g'ridan-to'g'ri reverb:8080):
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
VITE_REVERB_PATH=
#   Production (nginx /reverb/ WebSocket proxy — domen portida):
#     VITE_REVERB_APP_KEY=<REVERB_APP_KEY bilan bir xil>
#     VITE_REVERB_HOST=yetqaz.uz
#     VITE_REVERB_PORT=443
#     VITE_REVERB_SCHEME=https
#     VITE_REVERB_PATH=/reverb

# --- Octane (RoadRunner) ---
OCTANE_SERVER=roadrunner
OCTANE_HTTPS=false

# --- Telegram bot (Nutgram) ---
# Lokal: long polling (php artisan nutgram:run). Production: webhook.
TELEGRAM_BOT_TOKEN=
# Webhook rejimida Telegram X-Telegram-Bot-Api-Secret-Token sarlavhasida qaytaradi —
# soxta update'larni rad etish uchun. Tasodifiy 32+ belgi. (Hozircha kod ishlatmaydi;
# webhook route yoqilganda ulanadi — qarang docs/audit-2026-09.md PROD-6.)
TELEGRAM_WEBHOOK_SECRET=
# Production webhook URL (deploy skripti `nutgram:hook:set` da ishlatadi). Kelajak.
TELEGRAM_WEBHOOK_URL=
# Mini App public HTTPS manzili (bot inline tugmalari shuni ochadi). Lokalda —
# ngrok/cloudflared tunnel -> https://.../app
TELEGRAM_MINI_APP_URL=
# Nutgram ichki loglari qaysi kanalga (null = o'chiq). Prod: 'stack' — token
# loglarda [REDACTED] bo'ladi (App\Logging\RedactSecretsTap).
TELEGRAM_LOG_CHANNEL=null
# Mini App initData imzosi qancha vaqt yaroqli (soniya).
TELEGRAM_INIT_DATA_TTL=86400
# Faqat lokal: brauzerda (Telegramsiz) Mini App'ni sinash uchun imzolangan
# initData. Oling: docker compose exec app php artisan telegram:test-init-data <tg_id>
TELEGRAM_DEV_INIT_DATA=

# --- Marshrut / masofa ---
OSRM_BASE_URL=http://osrm:5000
ROUTING_FALLBACK_HAVERSINE_FACTOR=1.35
ETA_CACHE_TTL=3600

# --- Geokodlash: Nominatim (OpenStreetMap) ---
# `geo:fetch-coordinates` buyrug'i ishlatadi. Nominatim qoidasi: User-Agent'da
# aloqa manzili majburiy, soniyada 1 so'rov. O'z instansiyangiz bo'lsa URL'ni bering.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT=https://github.com/Turaboev-swe/Yetkaz-Uz

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@yetkaz.uz"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
# Yuklangan rasmlar (logo, taom) URL prefiksi. Nisbiy '/storage' — Mini App
# tunnel orqali ochilganda ham to'g'ri. Production'da to'liq domen ham bo'lishi mumkin.
FILESYSTEM_PUBLIC_URL=/storage
# Lokal test: demo restoranlar buyurtma bildirishnomasini shu Telegram chatga yuboradi
TELEGRAM_DEV_NOTIFY_CHAT_ID=

# --- Chek printeri (print agent) ---
# escpos restoranlari uchun agent tokeni. Seeder BurgerGrill'ga shu tokenni beradi.
# Agent sozlamalari: print-agent/.env.example (PRINTER_MODE, PRINTER_HOST, PRINTER_PORT)
PRINT_AGENT_TOKEN=
