APP_NAME=Yetkaz
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=uz
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=uz_UZ

# Vaqtlar bazada UTC saqlanadi, ko'rsatishda Asia/Tashkent ga o'giriladi.
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Baza: PostgreSQL 16 + PostGIS ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=yetkaz
DB_USERNAME=yetkaz
DB_PASSWORD=secret

# Host'ga ochiladigan portlar (boshqa loyihalar bilan to'qnashmasligi uchun nostandart)
APP_FORWARD_PORT=8010
REVERB_FORWARD_PORT=8080
DB_FORWARD_PORT=55432
REDIS_FORWARD_PORT=56379
VITE_FORWARD_PORT=5174

# Docker konteyner foydalanuvchi UID/GID — `id -u` / `id -g` bilan mos qiling.
UID=1000
GID=1000

# --- Navbat / kesh / sessiya: Redis ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=yetkaz

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Horizon shu ulanishdan foydalanadi
REDIS_QUEUE_CONNECTION=default
HORIZON_PREFIX=yetkaz_horizon:

# --- WebSocket: Laravel Reverb ---
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=yetkaz
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Octane (RoadRunner) ---
OCTANE_SERVER=roadrunner
OCTANE_HTTPS=false

# --- Telegram bot (Nutgram, webhook rejimi) ---
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MINI_APP_URL=

# --- Marshrut / masofa ---
OSRM_BASE_URL=http://osrm:5000
ROUTING_FALLBACK_HAVERSINE_FACTOR=1.35
ETA_CACHE_TTL=3600

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@yetkaz.uz"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
