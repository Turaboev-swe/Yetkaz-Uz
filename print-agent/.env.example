# Yetkaz print agent — oshxona kompyuterida ishlaydi.
# `cp .env.example .env` va to'ldiring.

# ── Backend (Laravel) manzili — agent /api/agent/* ga so'rov yuboradi ──
#   Lokal:      http://localhost:8010
#   Production: https://yetqaz.uz
BACKEND_URL=https://yetqaz.uz

# ── Restoran va uning print agent tokeni ──
#   RESTAURANT_ID       — admin panel yoki `php artisan print-agent:provision`
#   PRINT_AGENT_TOKEN   — serverdagi /root/<restoran>-print-agent-token.txt dan
RESTAURANT_ID=
PRINT_AGENT_TOKEN=

# ── Reverb (WebSocket) ──
#   Lokal:      HOST=localhost  PORT=8080  SCHEME=http   PATH=(bo'sh)
#   Production: HOST=yetqaz.uz  PORT=443   SCHEME=https  PATH=/reverb
#   (production'da Reverb domen portida ochilmaydi — nginx /reverb/ ni proxy qiladi)
REVERB_HOST=yetqaz.uz
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_PATH=/reverb
#   REVERB_APP_KEY — serverdagi .env dagi REVERB_APP_KEY bilan AYNAN bir xil
REVERB_APP_KEY=

# ── Printer rejimi ──
#   simulate — chekni output/ papkasiga .txt qilib yozadi (haqiqiy printer yo'q)
#   network  — PRINTER_HOST:PRINTER_PORT ga ESC/POS baytlarini yuboradi
PRINTER_MODE=simulate
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
